# MediaTrack — configuration
# Copy to .env and fill in real values.  NEVER commit the .env file.

# ---- Database (required) ---------------------------------------------------
# Render supplies this automatically when the database is linked in render.yaml.
# docker-compose supplies it automatically too.
# Local Postgres example:
DATABASE_URL=postgresql://mediatrack:mediatrack@localhost:5432/mediatrack

# ---- Session signing key (required in production) ---------------------------
# Sessions are HMAC-signed with this. Changing it logs everyone out.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- First admin account ---------------------------------------------------
# Only used when the users table is empty (i.e. the very first boot).
# Required in production — the app refuses to start with an empty database
# and no ADMIN_PASSWORD rather than create a well-known default login.
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me-before-first-boot

# ---- Environment -----------------------------------------------------------
# "production" turns on Secure cookies and strict CORS/secret checks.
ENVIRONMENT=development

# ---- CORS ------------------------------------------------------------------
# The dashboard is served by this same app, so same-origin requests need no
# CORS at all — leave blank in production. Set a comma-separated origin list
# only if you host the frontend elsewhere. "*" is dev-only.
CORS_ORIGINS=*

# ---- Uploaded photos -------------------------------------------------------
# Must point at a persistent volume in production; container disks are wiped
# on every deploy. Leave blank locally to keep using frontend/photos.
PHOTOS_DIR=

# ---- Optional --------------------------------------------------------------
# Force-disable Secure cookies (only if you terminate TLS oddly).
# COOKIE_SECURE=true
# Skip loading the seed screens on an empty database.
# SEED_ON_START=true
# Connection pool sizing.
# DB_POOL_MIN=1
# DB_POOL_MAX=10
# Port the server binds to (Render sets this for you).
# PORT=8000
